<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <location path="sitecore">
        <system.webServer>
            <httpProtocol>
                <customHeaders>
                    <add xdt:Transform="SetAttributes" xdt:Locator="Match(name)" name="Content-Security-Policy" value="default-src 'self' 'unsafe-inline' 'unsafe-eval' https://apps.sitecore.net; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.aptrinsic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.aptrinsic.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://s.gravatar.com https://*.wp.com/cdn.auth0.com/avatars https://cdn.auth0.com/avatars https://*.aptrinsic.com https://storage.googleapis.com https://cchmc.sitecoresandbox.cloud https://*.sitecoresandbox.cloud; connect-src 'self' https://*.aptrinsic.com https://cchmc.sitecoresandbox.cloud https://*.sitecoresandbox.cloud https://stylelabs.eu.auth0.com; frame-src 'self' https://*.sitecore-staging.cloud/auth https://*.sitecorecloud.io/auth https://cchmc.sitecoresandbox.cloud https://*.sitecoresandbox.cloud https://stylelabs.eu.auth0.com; child-src 'self' https://cchmc.sitecoresandbox.cloud https://*.sitecoresandbox.cloud https://stylelabs.eu.auth0.com; media-src 'self' https://cchmc.sitecoresandbox.cloud https://*.sitecoresandbox.cloud; block-all-mixed-content;"/>
                </customHeaders>
            </httpProtocol>
        </system.webServer>
    </location>
</configuration>
